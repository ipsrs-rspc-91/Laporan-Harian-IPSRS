function createAccountRow_(staffId,username,nama,role,bidang,shift,password){const now=nowIso(),staffSheet=getSheet(SHEET_STAFF);staffSheet.appendRow(objToRow(HEADERS.STAFF,{staff_id:staffId,nama:nama,jabatan:ROLE_LABELS[role]||role,role:role,bidang:bidang||'',shift:shift||'',status:'Aktif',created_at:now,updated_at:now}));const usersSheet=getSheet(SHEET_USERS),salt=randomSalt();usersSheet.appendRow(objToRow(HEADERS.USERS,{user_id:Utilities.getUuid(),username:username,password_hash:hashPassword(password,salt),password_salt:salt,staff_id:staffId,role:role,status:'Aktif',created_at:now,updated_at:now}));return username+' / '+password+'  (staff_id='+staffId+', role='+role+')';}
function seedInitialAccounts(){setupDatabase();const staffSheet=getSheet(SHEET_STAFF),usersSheet=getSheet(SHEET_USERS);if(staffSheet.getLastRow()>1||usersSheet.getLastRow()>1){Logger.log('STAFF/USERS sudah berisi data. Seeding dibatalkan supaya tidak menimpa data yang ada. Gunakan addNewStaffAccount() untuk menambah satu per satu jika perlu.');return;}const log=[];log.push(createAccountRow_('KAIPSRS','kaipsrs','KA IPSRS',ROLE_KA_IPSRS,'Semua','', 'KaIpsrs#2026'));log.push(createAccountRow_('ADM01','administrasi01','Administrasi IPSRS',ROLE_ADMINISTRASI,'Semua','','Admin#2026'));BIDANG_LIST.forEach(function(bidang){const slug=bidang.toLowerCase(),staffId='KASIE-'+bidang.toUpperCase(),username='kasie_'+slug,nama='Kasie '+bidang+' (belum diisi)';log.push(createAccountRow_(staffId,username,nama,ROLE_KASIE,bidang,'','Kasie#'+slug+'2026'));});BIDANG_LIST.forEach(function(bidang){const slug=bidang.toLowerCase();for(let n=1;n<=3;n++){const pad=String(n).padStart(2,'0'),staffId='STAF-'+bidang.toUpperCase()+'-'+pad,username='staf_'+slug+pad,nama='Staf '+bidang+' '+pad+' (belum diisi)';log.push(createAccountRow_(staffId,username,nama,ROLE_STAF,bidang,'','Staf#'+slug+pad));}});SHIFT_LIST.forEach(function(shift){const slug=shift.toLowerCase();for(let n=1;n<=2;n++){const pad=String(n).padStart(2,'0'),staffId='SHIFT-'+shift.toUpperCase()+'-'+pad,username='shift_'+slug+pad,nama='Petugas Shift '+shift+' '+pad+' (belum diisi)';log.push(createAccountRow_(staffId,username,nama,ROLE_PETUGAS_SHIFT,'',shift,'Shift#'+slug+pad));}});Logger.log('Seeding selesai ('+log.length+' akun). SEGERA ganti semua password ini:\n'+log.join('\n'));}
function slugifyUsername_(nama){return nama.toString().trim().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'.').replace(/^\.+|\.+$/g,'');}
function seedInitialStaff(){setupDatabase();const created=[],skipped=[];MASTER_STAFF_SEED.forEach(function(person,idx){const staffId='IPSRS-'+String(idx+1).padStart(3,'0'),existingStaff=getStaffById(staffId);if(existingStaff){skipped.push(staffId+' ('+person.nama+') -- sudah ada, dilewati.');return;}const now=nowIso(),staffSheet=getSheet(SHEET_STAFF);staffSheet.appendRow(objToRow(HEADERS.STAFF,{staff_id:staffId,nama:person.nama,jabatan:person.jabatan,role:person.role,bidang:person.bidang||'',shift:person.shift||'',status:'Aktif',created_at:now,updated_at:now}));const username=slugifyUsername_(person.nama),existingUser=findUserByUsername(username);if(existingUser){created.push('(STAFF dibuat, TAPI username "'+username+'" sudah dipakai user lain -- buat akun login manual lewat addNewStaffAccount()) -> '+person.nama+' ['+staffId+']');return;}const password='Ipsrs'+String(idx+1).padStart(3,'0')+'#2026',usersSheet=getSheet(SHEET_USERS),salt=randomSalt();usersSheet.appendRow(objToRow(HEADERS.USERS,{user_id:Utilities.getUuid(),username:username,password_hash:hashPassword(password,salt),password_salt:salt,staff_id:staffId,role:person.role,status:'Aktif',created_at:now,updated_at:now}));created.push(username+' / '+password+'  ->  '+person.nama+' ('+person.jabatan+', staff_id='+staffId+')');});const calonCreated=[],calonSkipped=[];CALON_STAFF_SEED.forEach(function(person,idx){const staffId='IPSRS-'+String(MASTER_STAFF_SEED.length+idx+1).padStart(3,'0'),existingStaff=getStaffById(staffId);if(existingStaff){calonSkipped.push(staffId+' ('+person.nama+') -- sudah ada, dilewati.');return;}const now=nowIso(),staffSheet=getSheet(SHEET_STAFF);staffSheet.appendRow(objToRow(HEADERS.STAFF,{staff_id:staffId,nama:person.nama,jabatan:'Calon SDM IPSRS',role:ROLE_STAF,bidang:'',shift:'',status:'Calon',created_at:now,updated_at:now}));calonCreated.push(staffId+': '+person.nama);});Logger.log('=== SEED 23 STAF ASLI + 7 CALON SDM IPSRS SELESAI ===\n\nAkun BARU dibuat ('+created.length+'):\n'+(created.join('\n')||'(tidak ada)')+'\n\nDilewati karena staff_id sudah ada ('+skipped.length+'):\n'+(skipped.join('\n')||'(tidak ada)')+'\n\nCALON SDM baru ditambahkan ke STAFF, TANPA akun login ('+calonCreated.length+'):\n'+(calonCreated.join('\n')||'(tidak ada)')+(calonSkipped.length?'\n\nCalon dilewati karena sudah ada:\n'+calonSkipped.join('\n'):'')+'\n\nCATATAN:\n1) Untuk Petugas Shift, isi manual kolom "shift" (Pagi/Siang/Malam) di sheet STAFF.\n2) SEGERA minta setiap orang mengganti password default di atas lewat menu "Ganti Password".\n3) Akun placeholder lama tidak disentuh -- nonaktifkan manual jika sudah tidak dipakai.\n4) Kalau seorang CALON diangkat aktif: ubah status barisnya di sheet STAFF jadi "Aktif" dan buat akun login untuk orang tersebut lewat addNewStaffAccount().');}
function addNewStaffAccount(staffId,username,nama,role,bidang,shift,initialPassword){setupDatabase();if(findUserByUsername(username)){Logger.log('GAGAL: username "'+username+'" sudah dipakai. Tidak ada akun yang dibuat.');return;}if(getStaffById(staffId)){Logger.log('GAGAL: staff_id "'+staffId+'" sudah dipakai. Tidak ada akun yang dibuat.');return;}Logger.log('Akun baru dibuat: '+createAccountRow_(staffId,username,nama,role,bidang,shift,initialPassword));}
