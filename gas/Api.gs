function apiLogin(username,password){try{setupDatabase();return login(username,password);}catch(err){return {ok:false,msg:'Error server: '+err.message};}}
function apiLogout(token){try{return logout(token);}catch(err){return {ok:false,msg:'Error server: '+err.message};}}
function apiWhoAmI(token){try{const s=validateSession(token);if(!s)return {ok:false,msg:'Sesi tidak valid, silakan login kembali.'};return {ok:true,username:s.username,staff_id:s.staff_id,nama:s.nama,bidang:s.bidang,shift:s.shift,role:s.role,role_label:ROLE_LABELS[s.role]||s.role};}catch(err){return {ok:false,msg:'Error server: '+err.message};}}
function apiCreateReport(token,payload){try{const s=validateSession(token);if(!s)return {ok:false,msg:'Sesi tidak valid, silakan login kembali.'};return createReport(s,payload||{});}catch(err){return {ok:false,msg:'Error server: '+err.message};}}
function apiGetReports(token,bulan,staffIdFilter,bidangFilter,shiftFilter){try{const s=validateSession(token);if(!s)return {ok:false,msg:'Sesi tidak valid, silakan login kembali.'};if(s.role!==ROLE_KA_IPSRS&&getAccessSetting_(ACCESS_SETTING_LAPORAN_TIM,ACCESS_ACTIVE)!==ACCESS_ACTIVE&&String(staffIdFilter||'')!==String(s.staff_id))return {ok:true,data:[]};if(s.role!==ROLE_KA_IPSRS&&String(staffIdFilter||'')===String(s.staff_id))staffIdFilter=s.staff_id;return getReports(s,bulan||'',staffIdFilter||null,bidangFilter||null,shiftFilter||null);}catch(err){return {ok:false,msg:'Error server: '+err.message};}}
function apiUpdateReport(token,reportId,payload){try{const s=validateSession(token);if(!s)return {ok:false,msg:'Sesi tidak valid, silakan login kembali.'};const permission=canEditReportById_(s,reportId||'');if(!permission.ok||!permission.owner)return {ok:false,msg:permission.msg||'Laporan tidak ditemukan.'};if(!permission.ok)return {ok:false,msg:'Anda tidak memiliki izin mengedit laporan ini.'};return updateReport(s,reportId,payload||{});}catch(err){return {ok:false,msg:'Error server: '+err.message};}}
function apiGetReportHistory(token,reportId){try{const s=validateSession(token);if(!s)return {ok:false,msg:'Sesi tidak valid, silakan login kembali.'};return getReportHistory(s,reportId);}catch(err){return {ok:false,msg:'Error server: '+err.message};}}
function apiListStaff(token){try{const s=validateSession(token);if(!s)return {ok:false,msg:'Sesi tidak valid, silakan login kembali.'};if(!isManagementRole_(s.role))return {ok:false,msg:'Akses ditolak.'};return listStaff(s);}catch(err){return {ok:false,msg:'Error server: '+err.message};}}
