/** CRUD laporan harian IPSRS. */
function createReport(session,payload){const lock=LockService.getScriptLock();if(!lock.tryLock(30000))return {ok:false,msg:'Server sedang sibuk (banyak petugas input bersamaan), silakan coba lagi.'};try{const sheet=getSheet(SHEET_REPORTS),now=nowIso(),reportId='RPT'+new Date().getTime()+'-'+Utilities.getUuid().split('-')[0];const obj={report_id:reportId,staff_id:session.staff_id,nama_snapshot:session.nama,bidang_snapshot:session.bidang||'',role_snapshot:session.role,shift_snapshot:session.shift||'',tanggal:payload.Tanggal||'',pelapor:payload.Pelapor||'',pukul:payload.Pukul||'',nolk:payload.NoLK||'',ruang:payload.Ruang||'',masalah_kegiatan:payload.MasalahKegiatan||'',tindakan:payload.Tindakan||'',status:payload.Status||'',keterangan:payload.Keterangan||'',kategori:payload.Kategori||'',area_kerja:payload.AreaKerja||'',item:payload.Item||'',spare_part_unit:payload.SparePartUnit||'',type:payload.Type||'',jumlah:payload.Jumlah||'',jadwal_kerja:payload.JadwalKerja||'',rencana_kegiatan:payload.RencanaKegiatan||'',target_pekerjaan:payload.TargetPekerjaan||'',realisasi_pekerjaan:payload.RealisasiPekerjaan||'',hasil_pencapaian:payload.HasilPencapaian||'',status_pencapaian:payload.StatusPencapaian||'',kendala:payload.Kendala||'',tindak_lanjut:payload.TindakLanjut||'',waktu_mulai:payload.WaktuMulai||'',waktu_selesai:payload.WaktuSelesai||'',created_at:now,updated_at:now,created_by_username:session.username,created_by_staff_id:session.staff_id,created_by_name:session.nama,created_by_role:session.role,updated_by_staff_id:session.staff_id,updated_by_name:session.nama,updated_by_role:session.role,version:1};if(!obj.tanggal)return {ok:false,msg:'Tanggal wajib diisi.'};if(!obj.masalah_kegiatan&&!obj.realisasi_pekerjaan)return {ok:false,msg:'Uraian pekerjaan wajib diisi (Masalah/Kegiatan atau Realisasi Pekerjaan).'};sheet.appendRow(objToRow(HEADERS.REPORTS,obj));logAudit(session.username,session.staff_id,'CREATE_REPORT',reportId,'');return {ok:true,report_id:reportId};}finally{lock.releaseLock();}}
function migrateExistingReports(){setupDatabase();const reportSheet=getSheet(SHEET_REPORTS),rows=reportSheet.getDataRange().getValues();if(rows.length<2){Logger.log('Tidak ada data REPORTS untuk dimigrasikan.');return;}const headers=rows[0],staffSheet=getSheet(SHEET_STAFF),staffRows=staffSheet.getDataRange().getValues(),staffHeaders=staffRows[0],staffByNama={};for(let i=1;i<staffRows.length;i++){const s=rowToObj(staffHeaders,staffRows[i]);if(!s.nama)continue;const key=s.nama.toString().trim().toLowerCase();staffByNama[key]=staffByNama[key]?'AMBIGU':s;}const staffIdIdx=headers.indexOf('staff_id'),namaSnapIdx=headers.indexOf('nama_snapshot'),bidangSnapIdx=headers.indexOf('bidang_snapshot'),roleSnapIdx=headers.indexOf('role_snapshot'),shiftSnapIdx=headers.indexOf('shift_snapshot'),pelaporIdx=headers.indexOf('pelapor'),reportIdIdx=headers.indexOf('report_id'),versionIdx=headers.indexOf('version');let migrated=0,alreadyOk=0,unmatched=0;const errorRows=[];for(let i=1;i<rows.length;i++){if(rows[i][staffIdIdx]){alreadyOk++;continue;}const reportId=rows[i][reportIdIdx],namaCandidate=(rows[i][namaSnapIdx]||rows[i][pelaporIdx]||'').toString().trim();if(!namaCandidate){unmatched++;errorRows.push([reportId,'(kosong)','Tidak ada nama_snapshot maupun pelapor untuk dicocokkan',nowIso()]);continue;}const match=staffByNama[namaCandidate.toLowerCase()];if(!match||match==='AMBIGU'){unmatched++;errorRows.push([reportId,namaCandidate,match==='AMBIGU'?'Nama cocok lebih dari 1 staf -- ambigu, perlu periksa manual':'Nama tidak ditemukan di STAFF',nowIso()]);continue;}sheet_setIfBlank_(reportSheet,i+1,staffIdIdx,match.staff_id);sheet_setIfBlank_(reportSheet,i+1,namaSnapIdx,match.nama);sheet_setIfBlank_(reportSheet,i+1,bidangSnapIdx,match.bidang||'');sheet_setIfBlank_(reportSheet,i+1,roleSnapIdx,match.role||'');sheet_setIfBlank_(reportSheet,i+1,shiftSnapIdx,match.shift||'');if(versionIdx>-1&&!rows[i][versionIdx])reportSheet.getRange(i+1,versionIdx+1).setValue(1);migrated++;}if(errorRows.length>0){const errSheet=getSheet(SHEET_MIGRATION_ERROR);errorRows.forEach(function(row){errSheet.appendRow(row);});}Logger.log('=== MIGRASI REPORTS SELESAI ===\nSudah punya staff_id sebelumnya (dilewati): '+alreadyOk+'\nBerhasil dimigrasikan: '+migrated+'\nTIDAK bisa dipetakan: '+unmatched);}
function sheet_setIfBlank_(sheet,rowNumber,colIdx,value){if(colIdx<0)return;const current=sheet.getRange(rowNumber,colIdx+1).getValue();if(current===''||current===null||current===undefined)sheet.getRange(rowNumber,colIdx+1).setValue(value);}
function mapReportToLegacyShape(r){return {ID:r.report_id,Tanggal:r.tanggal,Pelapor:r.pelapor,Ruang:r.ruang,Pukul:r.pukul,NoLK:r.nolk,MasalahKegiatan:r.masalah_kegiatan,Tindakan:r.tindakan,Petugas:r.nama_snapshot,Status:r.status,Keterangan:r.keterangan,Kategori:r.kategori,AreaKerja:r.area_kerja,Item:r.item,SparePartUnit:r.spare_part_unit,Type:r.type,Jumlah:r.jumlah,JadwalKerja:r.jadwal_kerja||'',RencanaKegiatan:r.rencana_kegiatan||'',TargetPekerjaan:r.target_pekerjaan||'',RealisasiPekerjaan:r.realisasi_pekerjaan||'',HasilPencapaian:r.hasil_pencapaian||'',StatusPencapaian:r.status_pencapaian||'',Kendala:r.kendala||'',TindakLanjut:r.tindak_lanjut||'',WaktuMulai:r.waktu_mulai||'',WaktuSelesai:r.waktu_selesai||'',StaffID:r.staff_id,Bidang:r.bidang_snapshot,Role:r.role_snapshot,Shift:r.shift_snapshot,CreatedAt:r.created_at,UpdatedAt:r.updated_at,CreatedByName:r.created_by_name||r.created_by_username||'',UpdatedByName:r.updated_by_name||'',Version:r.version||1};}
function getReports(session,bulan,staffIdFilter,bidangFilter,shiftFilter){const sheet=getSheet(SHEET_REPORTS),rows=sheet.getDataRange().getValues();if(rows.length<1)return {ok:true,data:[]};const headers=rows[0],out=[];for(let i=1;i<rows.length;i++){const r=rowToObj(headers,rows[i]);r.tanggal=normalizeTanggal_(r.tanggal);if(!r.report_id)continue;if(!canViewReport_(session,r.staff_id))continue;if(staffIdFilter&&r.staff_id!==staffIdFilter)continue;if(bidangFilter&&r.bidang_snapshot!==bidangFilter)continue;if(shiftFilter&&r.shift_snapshot!==shiftFilter)continue;if(bulan&&(r.tanggal||'').toString().indexOf(bulan)!==0)continue;out.push(mapReportToLegacyShape(r));}out.sort(function(a,b){return a.ID<b.ID?1:-1;});return {ok:true,data:out};}
function updateReport(session,reportId,payload){if(!reportId)return {ok:false,msg:'report_id wajib diisi.'};const lock=LockService.getScriptLock();if(!lock.tryLock(30000))return {ok:false,msg:'Server sedang sibuk, silakan coba lagi.'};try{const sheet=getSheet(SHEET_REPORTS),data=sheet.getDataRange().getValues(),headers=data[0],idIdx=headers.indexOf('report_id'),staffIdx=headers.indexOf('staff_id'),roleIdx=headers.indexOf('role_snapshot');for(let i=1;i<data.length;i++){if(data[i][idIdx]===reportId){const ownerStaffId=data[i][staffIdx],ownerRole=roleIdx>-1?data[i][roleIdx]:'',permission=canEditReport_(session,ownerStaffId,ownerRole);if(!permission){logAudit(session.username,session.staff_id,'UPDATE_REPORT_DENIED',reportId,'Tidak memiliki izin edit untuk laporan ini');return {ok:false,msg:'Anda tidak memiliki izin mengedit laporan ini.'};}const before=rowToObj(headers,data[i]);before.tanggal=normalizeTanggal_(before.tanggal);const versionBefore=parseInt(before.version,10)||1,versionAfter=versionBefore+1,changedFields=[];Object.keys(REPORT_EDITABLE_FIELD_MAP).forEach(function(col){const idx=headers.indexOf(col),payloadKey=REPORT_EDITABLE_FIELD_MAP[col];if(idx>-1&&payload[payloadKey]!==undefined){const oldVal=data[i][idx],newVal=payload[payloadKey];if(String(oldVal)!==String(newVal))changedFields.push({col:col,oldVal:oldVal,newVal:newVal});sheet.getRange(i+1,idx+1).setValue(newVal);}});setCellIfColumnExists_(sheet,headers,i+1,'updated_at',nowIso());setCellIfColumnExists_(sheet,headers,i+1,'updated_by_staff_id',session.staff_id);setCellIfColumnExists_(sheet,headers,i+1,'updated_by_name',session.nama);setCellIfColumnExists_(sheet,headers,i+1,'updated_by_role',session.role);setCellIfColumnExists_(sheet,headers,i+1,'version',versionAfter);const afterRow=sheet.getRange(i+1,1,1,headers.length).getValues()[0],after=rowToObj(headers,afterRow);after.tanggal=normalizeTanggal_(after.tanggal);saveReportHistory(session,reportId,before,after);const isElevatedEditor=(session.role===ROLE_KA_IPSRS||session.role===ROLE_ADMINISTRASI)&&String(ownerStaffId)!==String(session.staff_id);logAudit(session.username,session.staff_id,'UPDATE_REPORT',reportId,isElevatedEditor?('Diedit oleh '+(ROLE_LABELS[session.role]||session.role)+' ('+session.nama+'), pemilik: '+before.nama_snapshot):'',{field_changed:changedFields.map(function(c){return c.col;}).join(', '),old_value:changedFields.map(function(c){return c.col+'='+c.oldVal;}).join(' | '),new_value:changedFields.map(function(c){return c.col+'='+c.newVal;}).join(' | '),version_before:versionBefore,version_after:versionAfter});return {ok:true,version:versionAfter};}}return {ok:false,msg:'Laporan tidak ditemukan.'};}finally{lock.releaseLock();}}
function setCellIfColumnExists_(sheet,headers,rowNumber,columnName,value){const idx=headers.indexOf(columnName);if(idx>-1)sheet.getRange(rowNumber,idx+1).setValue(value);}
function saveReportHistory(session,reportId,beforeObj,afterObj){try{const sheet=getSheet(SHEET_HISTORY);sheet.appendRow(objToRow(HEADERS.REPORT_HISTORY,{history_id:Utilities.getUuid(),report_id:reportId,edited_at:nowIso(),edited_by_username:session.username,edited_by_staff_id:session.staff_id,data_before_json:JSON.stringify(mapReportToLegacyShape(beforeObj)),data_after_json:JSON.stringify(mapReportToLegacyShape(afterObj))}));}catch(e){}}
function getReportHistory(session,reportId){if(session.role!==ROLE_KA_IPSRS&&session.role!==ROLE_ADMINISTRASI)return {ok:false,msg:'Hanya KA IPSRS atau Administrasi yang dapat melihat riwayat perubahan.'};const sheet=getSheet(SHEET_HISTORY),rows=sheet.getDataRange().getValues();if(rows.length<1)return {ok:true,data:[]};const headers=rows[0],out=[];for(let i=1;i<rows.length;i++){const r=rowToObj(headers,rows[i]);if(r.report_id!==reportId)continue;out.push({history_id:r.history_id,edited_at:r.edited_at,edited_by_username:r.edited_by_username,edited_by_staff_id:r.edited_by_staff_id,before:JSON.parse(r.data_before_json||'{}'),after:JSON.parse(r.data_after_json||'{}')});}out.sort(function(a,b){return a.edited_at<b.edited_at?1:-1;});return {ok:true,data:out};}
function getDashboardStats(session,bulan,staffIdFilter,bidangFilter,shiftFilter){const sheet=getSheet(SHEET_REPORTS),rows=sheet.getDataRange().getValues(),empty={total:0,selesai:0,belum:0,pencapaian:{'Selesai':0,'Sebagian':0,'Belum Selesai':0,'Ditunda':0,'Tindak Lanjut':0,'Belum Diisi':0},kategori:[],area:[],staff:[],bidang:[],recent:[]};if(rows.length<1)return {ok:true,data:empty};const headers=rows[0];let total=0,selesai=0,belum=0;const byKategori={},byArea={},byStaffCount={},byStaffNama={},byBidang={},byPencapaian={'Selesai':0,'Sebagian':0,'Belum Selesai':0,'Ditunda':0,'Tindak Lanjut':0,'Belum Diisi':0},recent=[];for(let i=1;i<rows.length;i++){const r=rowToObj(headers,rows[i]);r.tanggal=normalizeTanggal_(r.tanggal);if(!r.report_id)continue;if(!canViewReport_(session,r.staff_id))continue;if(staffIdFilter&&r.staff_id!==staffIdFilter)continue;if(bidangFilter&&r.bidang_snapshot!==bidangFilter)continue;if(shiftFilter&&r.shift_snapshot!==shiftFilter)continue;if(bulan&&(r.tanggal||'').toString().indexOf(bulan)!==0)continue;total++;if((r.status||'').toString().toLowerCase().indexOf('selesai')>-1)selesai++;else belum++;const sp=(r.status_pencapaian||'').toString();if(byPencapaian.hasOwnProperty(sp)&&sp!=='')byPencapaian[sp]++;else byPencapaian['Belum Diisi']++;if(r.kategori)byKategori[r.kategori]=(byKategori[r.kategori]||0)+1;if(r.area_kerja)byArea[r.area_kerja]=(byArea[r.area_kerja]||0)+1;if(r.bidang_snapshot)byBidang[r.bidang_snapshot]=(byBidang[r.bidang_snapshot]||0)+1;if(r.staff_id){byStaffCount[r.staff_id]=(byStaffCount[r.staff_id]||0)+1;byStaffNama[r.staff_id]=r.nama_snapshot;}recent.push(mapReportToLegacyShape(r));}recent.sort(function(a,b){return a.ID<b.ID?1:-1;});function toSortedArray(obj){return Object.keys(obj).map(function(k){return {label:k,value:obj[k]};}).sort(function(a,b){return b.value-a.value;});}return {ok:true,data:{total:total,selesai:selesai,belum:belum,pencapaian:byPencapaian,kategori:toSortedArray(byKategori).slice(0,6),area:toSortedArray(byArea).slice(0,6),bidang:toSortedArray(byBidang),staff:Object.keys(byStaffCount).map(function(sid){return {staff_id:sid,nama:byStaffNama[sid],value:byStaffCount[sid]};}).sort(function(a,b){return b.value-a.value;}).slice(0,8),recent:recent.slice(0,6)}};}
