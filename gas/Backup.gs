function installBackupTriggers(){ScriptApp.getProjectTriggers().forEach(function(t){const fn=t.getHandlerFunction();if(fn==='dailyBackup'||fn==='weeklyBackup')ScriptApp.deleteTrigger(t);});ScriptApp.newTrigger('dailyBackup').timeBased().everyDays(1).atHour(23).create();ScriptApp.newTrigger('weeklyBackup').timeBased().onWeekDay(ScriptApp.WeekDay.SUNDAY).atHour(23).create();Logger.log('Trigger backup harian & mingguan sudah dipasang.');}
function getOrCreateFolder(parent,name){const it=parent.getFoldersByName(name);if(it.hasNext())return it.next();return parent.createFolder(name);}
function backupSpreadsheet(subfolderName,keep){const ss=getSS(),root=getOrCreateFolder(DriveApp.getRootFolder(),'BACKUP IPSRS'),sub=getOrCreateFolder(root,subfolderName),file=DriveApp.getFileById(ss.getId()),stamp=Utilities.formatDate(new Date(),'Asia/Jakarta','yyyy-MM-dd_HHmm'),copyName='IPSRS_DB_'+subfolderName+'_'+stamp;file.makeCopy(copyName,sub);if(keep&&keep>0){const files=[],it=sub.getFiles();while(it.hasNext())files.push(it.next());files.sort(function(a,b){return b.getDateCreated()-a.getDateCreated();});for(let i=keep;i<files.length;i++)files[i].setTrashed(true);}}
function dailyBackup(){backupSpreadsheet('Harian',30);}
function weeklyBackup(){backupSpreadsheet('Mingguan',12);}
function archiveBackupNow(){backupSpreadsheet('Arsip',0);Logger.log('Arsip backup dibuat di folder BACKUP IPSRS/Arsip.');}
